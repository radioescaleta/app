    <style>
        .error-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 6rem 0 5rem;
            text-align: center;
            color: white;
            position: relative;
            overflow: hidden;
        }
        .error-hero::before {
            content: "🔇";
            position: absolute;
            font-size: 20rem;
            opacity: 0.1;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0%, 100% { transform: translate(-50%, -50%) translateY(0px); }
            50% { transform: translate(-50%, -50%) translateY(-20px); }
        }
        .error-hero h1 {
            font-size: 8rem;
            font-weight: 700;
            margin-bottom: 1rem;
            text-shadow: 0 4px 20px rgba(0,0,0,0.2);
            position: relative;
            z-index: 1;
        }
        .error-hero h2 {
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }
        .error-hero p {
            font-size: 1.25rem;
            opacity: 0.95;
            max-width: 600px;
            margin: 0 auto 2.5rem;
            position: relative;
            z-index: 1;
        }
        .error-emojis {
            font-size: 3rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: center;
            gap: 1rem;
            position: relative;
            z-index: 1;
        }
        .error-emojis span {
            display: inline-block;
            animation: bounce 1s ease-in-out infinite;
        }
        .error-emojis span:nth-child(2) {
            animation-delay: 0.1s;
        }
        .error-emojis span:nth-child(3) {
            animation-delay: 0.2s;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .home-button {
            display: inline-block;
            background: white;
            color: #667eea;
            padding: 1.25rem 3rem;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
        }
        .home-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.3);
            background: #f8f9fa;
        }
        .funny-suggestions {
            background: #fef9e7;
            border: 2px dashed #f39c12;
            border-radius: 16px;
            padding: 2.5rem;
            margin: 3rem auto;
            max-width: 800px;
            text-align: left;
        }
        .funny-suggestions h3 {
            color: #d68910;
            font-size: 1.5rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .funny-suggestions h3::before {
            content: "🤔";
            font-size: 2rem;
        }
        .funny-suggestions ul {
            list-style: none;
            padding: 0;
        }
        .funny-suggestions li {
            padding: 0.75rem 0;
            color: #7d6608;
            font-size: 1.1rem;
            line-height: 1.7;
        }
        .funny-suggestions li::before {
            content: "→ ";
            color: #f39c12;
            font-weight: 700;
            margin-right: 0.5rem;
        }
        @media (max-width: 768px) {
            .error-hero h1 {
                font-size: 5rem;
            }
            .error-hero h2 {
                font-size: 1.5rem;
            }
            .error-hero p {
                font-size: 1.1rem;
            }
            .funny-suggestions {
                padding: 2rem 1.5rem;
            }
        }
    </style>
