rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de ayuda para comprobar si el usuario ha iniciado sesión
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función para comprobar si el usuario es el dueño del programa
    function isOwner(resourceData) {
      return isAuthenticated() && ('ownerId' in resourceData) && resourceData.ownerId == request.auth.uid;
    }

    // Función para comprobar si el usuario es colaborador (cualquier rol)
    function isCollaborator(resourceData) {
      return isAuthenticated() && ('collaborators' in resourceData) && (request.auth.uid in resourceData.collaborators);
    }
    
    // Reglas para la colección "users"
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Reglas para la colección "programs"
    match /programs/{programId} {
      
      // CREATE: Solo pueden crear programas los usuarios logueados, 
      // y obligatoriamente deben ponerse a sí mismos como dueños.
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      // READ: Puedes leer el programa si eres el dueño o si estás en la lista de colaboradores.
      allow read: if isOwner(resource.data) || isCollaborator(resource.data);
      
      // UPDATE: Puedes editar la escaleta si eres el dueño, 
      // o si eres un colaborador con rol de 'editor'.
      allow update: if isOwner(resource.data) || 
                   (isCollaborator(resource.data) && resource.data.collaborators[request.auth.uid] == 'editor');
                   
      // DELETE: Solo el dueño absoluto puede borrar el programa entero.
      allow delete: if request.auth != null;
    }
  }
}
