rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // COLECCIÓN: users
    // ==============================
    // Cualquier usuario autenticado puede leer y escribir perfiles.
    // El control de roles (superadmin, docente, alumno) lo gestiona
    // el código JavaScript de la aplicación (dbService.js → loginUser).
    match /users/{docId} {
      allow read, write: if request.auth != null;
    }

    // ==============================
    // COLECCIÓN: programs
    // ==============================
    match /programs/{programId} {

      // LEER: el dueño, un colaborador, o cualquier usuario autenticado
      // (necesario para que los docentes puedan revisar programas de alumnos)
      allow read: if request.auth != null;

      // CREAR: solo puede crear programas que le pertenezcan
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      // ACTUALIZAR: el dueño o un colaborador con rol "editor"
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || resource.data.collaborators[request.auth.uid] == 'editor');

      // BORRAR: solo el dueño
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ==============================
    // COLECCIÓN: sounds (librería de sonidos)
    // ==============================
    match /sounds/{soundId} {
      // Cualquier usuario autenticado puede leer (el editor la necesita)
      allow read: if request.auth != null;

      // Solo el superadmin puede crear, modificar o borrar sonidos
      allow write: if request.auth != null
                   && request.auth.token.email == 'bernat13@gmail.com';
    }
  }
}
